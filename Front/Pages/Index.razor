@page "/"

<div class="min-vh-100 d-flex flex-column">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 py-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/">
                <i class="bi bi-cup-hot-fill me-2"></i>RestoApp
            </a>

            <div class="d-flex gap-3">
                <a href="/login" class="btn btn-outline-light px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Connexion
                </a>
                <a href="/register" class="btn btn-warning fw-semibold px-4">
                    <i class="bi bi-person-plus me-2"></i>Inscription
                </a>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center bg-light py-5">
        <div class="container text-center py-5">
            <h1 class="fw-bold display-4 mb-4">
                Bienvenue chez <span class="text-primary">RestoApp</span>
            </h1>

            <p class="text-muted fs-4 mb-5 mx-auto" style="max-width: 700px;">
                Gérez votre restaurant facilement : menus, catégories, articles,
                commandes et clients — tout depuis une seule plateforme moderne.
            </p>

            <div class="row justify-content-center g-4 mt-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-primary bg-gradient d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-menu-button-wide text-white fs-3"></i>
                            </div>
                            <h4 class="card-title fw-bold">Gestion des Menus</h4>
                            <p class="card-text text-muted">
                                Créez et modifiez facilement vos menus avec des catégories organisées
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-success bg-gradient d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-cart-check text-white fs-3"></i>
                            </div>
                            <h4 class="card-title fw-bold">Commandes</h4>
                            <p class="card-text text-muted">
                                Gérez les commandes en temps réel avec notifications
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-warning bg-gradient d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-graph-up text-white fs-3"></i>
                            </div>
                            <h4 class="card-title fw-bold">Analyses</h4>
                            <p class="card-text text-muted">
                                Suivez vos performances avec des tableaux de bord détaillés
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <a href="/register" class="btn btn-primary btn-lg px-5 py-3 fw-semibold">
                    <i class="bi bi-rocket-takeoff me-2"></i>Commencer gratuitement
                </a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-dark text-light py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-cup-hot-fill me-2"></i>RestoApp
                    </h5>
                    <p class="text-secondary mb-0">
                        La plateforme de gestion de restaurant moderne
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <small class="text-secondary">
                        © @DateTime.Now.Year RestoApp — Tous droits réservés
                    </small>
                </div>
            </div>
        </div>
    </footer>

</div>

<style>
    :root {
        --primary: #4361ee;
        --secondary: #3a0ca3;
        --success: #4cc9f0;
    }

    body {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .navbar {
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
    }

    .navbar-brand {
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .card {
        border-radius: 12px;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn-primary {
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        border: none;
        border-radius: 50px;
        padding: 0.75rem 2rem;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
        }

    .btn-warning {
        background: linear-gradient(90deg, #ff9e00, #ffc107);
        border: none;
        border-radius: 50px;
        padding: 0.75rem 2rem;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }

    .bg-gradient {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
    }
</style>