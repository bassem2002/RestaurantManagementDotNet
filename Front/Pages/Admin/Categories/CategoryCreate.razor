@page "/admin/categories/create"
@attribute [Authorize(Roles = "Admin")]
@using Backend.Models
@using Front.Services
@using System.ComponentModel.DataAnnotations
@layout AdminLayout


@inject NavigationManager Navigation
@inject CategorieServices CategorieServices

<div class="container-fluid">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h4 class="fw-semibold mb-4">
                        Créer une catégorie
                    </h4>

                    <EditForm Model="category" OnValidSubmit="handlesubmit">
                     <DataAnnotationsValidator/>
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">
                                Nom de la catégorie
                            </label>

                            <InputText id="categoryName"
                                       class="form-control"
                                       placeholder="Ex: Boissons"
                                       @bind-Value="category.Name" />
                            <ValidationMessage For="@(() => category.Name)" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Créer
                            </button>
                        </div>

                    </EditForm>

                </div>
            </div>

        </div>
    </div>

</div>


@code {
    private Category category { get; set; } = new Category();

    private async Task handlesubmit(EditContext args)
    {
        var result = await CategorieServices.CreateCategoryAsync(category);
        if (result != null)
        {
            Navigation.NavigateTo("admin/categories");
        }
    }
    public class CategoryDto
    {
        [Required(ErrorMessage = "Le nom de la catégorie est requis")]
        public string Name { get; set; }
    }
}
