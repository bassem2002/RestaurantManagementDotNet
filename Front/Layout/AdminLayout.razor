@inherits LayoutComponentBase
@inject Front.Services.AuthService Auth
@inject NavigationManager Nav

<!-- Navbar Admin -->
<div class="navbar navbar-dark bg-dark sticky-top shadow-sm px-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="/">Admin Panel</a>

        <div class="d-flex align-items-center gap-2 ms-auto">
            <!-- Bouton Logout -->
            <button class="btn btn-outline-light btn-sm" @onclick="Logout">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>

            <!-- Toggler Sidebar -->
            <button class="navbar-toggler border-0" type="button" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>
</div>

<!-- Sidebar -->
<div class="@SidebarCssClass position-fixed top-0 start-0 bg-light border-end vh-100 overflow-auto pt-5"
     style="width: 260px; z-index: 1030;">
    <NavMenu />
</div>

<!-- Contenu principal -->
<div style="margin-left: 260px; padding-top: 70px; min-height: 100vh; background-color: #f8f9fa;">
    @Body
</div>

@code {
    // Gestion du Sidebar
    private bool isSidebarCollapsed = true;
    private string SidebarCssClass => isSidebarCollapsed ? "d-none d-lg-block" : "d-block";

    private void ToggleNavMenu()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    // Logout Admin
    private async Task Logout()
    {
        await Auth.LogoutAsync();          // Appelle la méthode LogoutAsync du AuthService
        Nav.NavigateTo("/login", true);    // Redirige vers la page login
    }
}
