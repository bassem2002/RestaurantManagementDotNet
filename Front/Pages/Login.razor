@page "/login"

@using Front.Models
@using System.Security.Claims
@inject Front.Services.IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider _authStateProvider

<PageTitle>Connexion - RestoApp</PageTitle>

<div class="min-vh-100 d-flex">
    <!-- Section gauche - Illustration -->
    <div class="d-none d-lg-flex col-lg-7 bg-primary position-relative overflow-hidden">
        <div class="position-absolute top-0 start-0 w-100 h-100">
            <!-- Motifs décoratifs -->
            <div class="position-absolute top-0 end-0 w-50 h-50 bg-white opacity-10 rounded-circle"
                 style="transform: translate(30%, -30%);"></div>
            <div class="position-absolute bottom-0 start-0 w-75 h-75 bg-white opacity-5 rounded-circle"
                 style="transform: translate(-40%, 40%);"></div>

            <!-- Vagues décoratives -->
            <svg class="position-absolute bottom-0 start-0 w-100" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z"
                      opacity=".25" fill="white"></path>
                <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z"
                      opacity=".5" fill="white"></path>
                <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="white"></path>
            </svg>
        </div>

        <!-- Contenu de la section gauche -->
        <div class="position-relative z-1 d-flex flex-column justify-content-center text-white p-5">
            <div class="mb-5">
                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-cup-hot-fill fs-1 me-3"></i>
                    <h1 class="display-4 fw-bold mb-0">RestoApp</h1>
                </div>
                <p class="lead opacity-90">La solution moderne pour la gestion de votre restaurant</p>
            </div>

            <div class="mt-5">
                <h3 class="h4 fw-bold mb-4">Pourquoi choisir RestoApp ?</h3>
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-check-circle-fill fs-5 me-3 opacity-90"></i>
                    <div>
                        <h5 class="fw-semibold">Gestion simplifiée</h5>
                        <p class="opacity-75 mb-0">Tous vos outils en un seul endroit</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-check-circle-fill fs-5 me-3 opacity-90"></i>
                    <div>
                        <h5 class="fw-semibold">Interface intuitive</h5>
                        <p class="opacity-75 mb-0">Facile à utiliser pour toute l'équipe</p>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill fs-5 me-3 opacity-90"></i>
                    <div>
                        <h5 class="fw-semibold">Support 24/7</h5>
                        <p class="opacity-75 mb-0">Nous sommes là pour vous aider</p>
                    </div>
                </div>
            </div>

            <div class="mt-auto pt-5">
                <div class="d-flex align-items-center opacity-75">
                    <i class="bi bi-star-fill me-2"></i>
                    <span>Noté 4.8/5 par plus de 500 restaurants</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section droite - Formulaire -->
    <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center p-4">
        <div class="w-100" style="max-width: 400px;">
            <!-- Logo mobile -->
            <div class="d-block d-lg-none text-center mb-5">
                <div class="d-flex justify-content-center align-items-center mb-3">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center"
                         style="width: 60px; height: 60px;">
                        <i class="bi bi-cup-hot-fill text-white fs-3"></i>
                    </div>
                </div>
                <h1 class="h3 fw-bold text-primary">RestoApp</h1>
                <p class="text-muted">Gestion de restaurant moderne</p>
            </div>

            <!-- Titre formulaire -->
            <div class="text-center mb-5">
                <h2 class="h1 fw-bold mb-2">Bienvenue</h2>
                <p class="text-muted">Connectez-vous à votre compte</p>
            </div>

            <!-- Formulaire -->
            <EditForm Model="@credentials" OnValidSubmit="@HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger rounded-3" />

                <!-- Champ utilisateur -->
                <div class="mb-4">
                    <label class="form-label fw-semibold mb-2">Nom d'utilisateur</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-person text-primary"></i>
                        </span>
                        <InputText class="form-control form-control-lg border-start-0 ps-0"
                                   @bind-Value="credentials.Username"
                                   placeholder="ex: username" />
                    </div>
                </div>

                <!-- Champ mot de passe -->
                <div class="mb-4">
                    <label class="form-label fw-semibold mb-2">Mot de passe</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-lock text-primary"></i>
                        </span>
                        <InputText type="password"
                                   class="form-control form-control-lg border-start-0 ps-0"
                                   @bind-Value="credentials.Password"
                                   placeholder="Votre mot de passe" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-3"></i>
                        <div class="small">@errorMessage</div>
                    </div>
                }

                <!-- Bouton de connexion -->
                <button class="btn btn-primary w-100 py-3 fw-semibold mt-3"
                        type="submit"
                        disabled="@isSubmitting">

                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <i>Connexion en cours</i>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        <i>Se connecter</i>
                    }

                </button>

            </EditForm>

            <!-- Séparateur -->
            <div class="d-flex align-items-center my-5">
                <div class="flex-grow-1 border-top"></div>
                <span class="px-3 text-muted small">OU</span>
                <div class="flex-grow-1 border-top"></div>
            </div>

            <!-- Lien inscription -->
            <div class="text-center">
                <p class="text-muted mb-3">Nouveau sur RestoApp ?</p>
                <a href="/register" class="btn btn-outline-primary btn-lg w-100 py-3">
                    <i class="bi bi-person-plus me-2"></i>
                    Créer un nouveau compte
                </a>
            </div>

            <!-- Retour accueil -->
            <div class="text-center mt-4 pt-3">
                <a href="/" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i>
                    Retour à la page d'accueil
                </a>
            </div>

            <!-- Informations de test -->
            <div class="mt-5 pt-4 border-top">
                <p class="text-center text-muted small mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    Comptes de démonstration :
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <div class="text-center">
                        <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 mb-1">
                            Admin
                        </div>
                        <div class="small text-muted">admin / admin123</div>
                    </div>
                    <div class="text-center">
                        <div class="badge bg-success bg-opacity-10 text-success px-3 py-2 mb-1">
                            Client
                        </div>
                        <div class="small text-muted">client / client123</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #4361ee;
        --primary-dark: #3a0ca3;
        --secondary: #f72585;
        --light: #f8f9fa;
    }

    body {
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        background: #fafbfc;
        overflow-x: hidden;
    }

    .bg-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark)) !important;
    }

    .form-control-lg {
        padding: 0.85rem 0;
        font-size: 1rem;
        border-radius: 0;
        border: none;
        border-bottom: 2px solid #e0e0e0;
        background: transparent;
    }

        .form-control-lg:focus {
            box-shadow: none;
            border-bottom-color: var(--primary);
        }

    .input-group-text {
        background: transparent;
        border: none;
        border-bottom: 2px solid #e0e0e0;
        padding: 0.85rem 0.75rem 0.85rem 0;
    }

    .btn-primary {
        background: linear-gradient(90deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3);
        }

    .btn-outline-primary {
        border-radius: 10px;
        border-width: 2px;
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    .alert-danger {
        border: none;
        background-color: rgba(220, 53, 69, 0.08);
        color: #dc3545;
    }

    .badge {
        border-radius: 8px;
        font-weight: 600;
    }

    /* Animation subtile pour les champs */
    .form-control-lg {
        transition: border-color 0.3s ease;
    }

    /* Style pour les liens */
    a {
        transition: color 0.2s ease;
    }

        a:hover {
            color: var(--primary) !important;
        }

    /* Responsive adjustments */
    @@media (max-width: 992px) {
        .min-vh-100 {
            min-height: auto;
            padding: 2rem 0;
        }
    }
</style>

@code {
    private LoginRequest credentials = new();
    private string errorMessage = "";
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        // Pré-remplir avec des valeurs de démo (optionnel)
        // credentials.Username = "admin";
        // credentials.Password = "admin123";
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        isSubmitting = true;
        try
        {
            var result = await AuthService.LoginAsync(credentials);
            if (result.IsSuccess)
            {
                await Task.Delay(300);

                // Récupérer l'état d'authentification mis à jour
                var authState = await _authStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;

                if (user.Identity?.IsAuthenticated == true)
                {
                    var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value
                                 ?? user.FindFirst("role")?.Value
                                 ?? user.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;

                    if (roleClaim == "Admin")
                    {
                        Navigation.NavigateTo("/admin", true);
                        return;
                    }
                    else if (roleClaim == "Client")
                    {
                        Navigation.NavigateTo("/client/dashboard", true);
                        return;
                    }
                }

                // Par défaut
                Navigation.NavigateTo("/", true);
            }
            else
            {
                errorMessage = result.Error ?? "Identifiants incorrects. Veuillez réessayer.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erreur de connexion.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}