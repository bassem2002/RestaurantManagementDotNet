@page "/admin/orders"
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager Navigation
@layout AdminLayout
<PageTitle>Admin Orders</PageTitle>

<h3>Admin - Orders</h3>

@if (orders == null)
{
    <p><em>Loading orders...</em></p>
}
else if (!orders.Any())
{
    <p>No orders found.</p>
}
else
{
    @foreach (var order in orders)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div>
                    <strong>Order #@order.OrderId</strong> - @order.Username , @order.Address
                </div>

                <div class="d-flex align-items-center gap-2">
                    <small>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>

                    <button class="btn btn-sm btn-light"
                            @onclick="() => GoToDetails(order.OrderId)">
                        Details
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Item Name</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.OrderItems)
                        {
                            <tr>
                                <td>@item.Item.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice</td>
                                <td>@(item.UnitPrice* item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th>@order.OrderItems.Sum(i => i.Quantity * i.UnitPrice)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<AdminOrderDTO> orders;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // This assumes your API returns orders with embedded OrderItems and Items
            orders = await Http.GetFromJsonAsync<List<AdminOrderDTO>>("api/order");

            // Safety check: make sure OrderItems are not null
            foreach (var order in orders)
            {
                if (order.OrderItems == null)
                    order.OrderItems = new List<AdminOrderItemDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading orders: " + ex.Message);
        }
    }
    private void GoToDetails(int orderId)
    {
        Navigation.NavigateTo($"/admin/orders/details/{orderId}");
    }

}
