@page "/admin"
@attribute [Authorize(Roles = "Admin")]

@inject Frontend.Services.AdminOrderService orderService
@inject NavigationManager Navigation
@layout AdminLayout

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>📊 Tableau de Bord Admin</h2>
            <p class="text-muted">Bienvenue sur votre espace d'administration</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>
    }
    else
    {
        <!-- STATISTIQUES PRINCIPALES -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Total Commandes</h6>
                        <h2 class="mb-0">@orders.Count</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Commandes Livrées</h6>
                        <h2 class="mb-0">@orders.Count(o => o.Status == "Delivered")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-warning text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">En Traitement</h6>
                        <h2 class="mb-0">@orders.Count(o => o.Status == "Processing")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Revenue</h6>
                        <h2 class="mb-0">@orders.Sum(o => o.Total).ToString("F0") DT</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRAPHIQUES & DÉTAILS -->
        <div class="row">
            <!-- STATUT DES COMMANDES -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Statut des Commandes</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>En Attente</span>
                                <span class="badge bg-warning">@orders.Count(o => o.Status == "Pending")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>En Traitement</span>
                                <span class="badge bg-info">@orders.Count(o => o.Status == "Processing")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Expédiée</span>
                                <span class="badge bg-primary">@orders.Count(o => o.Status == "Shipped")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Livrée</span>
                                <span class="badge bg-success">@orders.Count(o => o.Status == "Delivered")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Annulée</span>
                                <span class="badge bg-danger">@orders.Count(o => o.Status == "Cancelled")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COMMANDES RÉCENTES -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Commandes Récentes</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Date</th>
                                        <th>Montant</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in orders.OrderByDescending(o => o.OrderDate).Take(5))
                                    {
                                        <tr>
                                            <td>#@order.OrderId</td>
                                            <td>@order.OrderDate?.ToString("dd/MM/yyyy")</td>
                                            <td>@order.Total.ToString("F2") DT</td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(order.Status)">
                                                    @GetStatusDisplay(order.Status)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a href="/admin/orders" class="btn btn-sm btn-outline-primary mt-2">Voir toutes les commandes</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MENU D'ACCÈS RAPIDE -->
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Accès Rapide</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <a href="/admin/categories" class="btn btn-outline-primary w-100">
                                    📦 Catégories
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/admin/items" class="btn btn-outline-success w-100">
                                    🍽️ Articles
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/admin/orders" class="btn btn-outline-warning w-100">
                                    📋 Commandes
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/admin/clients" class="btn btn-outline-info w-100">
                                    👥 Clients
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Frontend.Services.OrderDto> orders = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = await orderService.GetAllOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusDisplay(string status)
    {
        return status switch
        {
            "Pending" => "En Attente",
            "Processing" => "En Traitement",
            "Shipped" => "Expédiée",
            "Delivered" => "Livrée",
            "Cancelled" => "Annulée",
            _ => status
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "badge bg-warning",
            "Processing" => "badge bg-info",
            "Shipped" => "badge bg-primary",
            "Delivered" => "badge bg-success",
            "Cancelled" => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }
}
