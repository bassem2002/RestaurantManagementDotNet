@page "/client/order-confirmation/{OrderId:int}"
@attribute [Authorize(Roles = "Client")]
@layout ClientLayout
@inject Frontend.Services.OrderClientService orderService
@inject NavigationManager navigationManager
@using Front.Models

<div class="container mt-5">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3">Chargement de votre commande...</p>
        </div>
    }
    else if (order == null)
    {
        <div class="alert alert-danger">
            <h4>Erreur</h4>
            <p>Impossible de charger la commande. Veuillez <a href="/client/orders">vérifier vos commandes</a>.</p>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- SUCCÈS -->
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <div style="font-size: 48px; margin-right: 20px;">??</div>
                        <div>
                            <h4 class="alert-heading">Commande Confirmée!</h4>
                            <p class="mb-0">Votre commande a été reçue avec succès et est en cours de traitement.</p>
                        </div>
                    </div>
                </div>

                <!-- DÉTAILS DE LA COMMANDE -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Détails de la Commande #@order.OrderId</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Date de Commande:</strong>
                                <p>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Statut:</strong>
                                <p>
                                    <span class="badge bg-info">@order.Status</span>
                                </p>
                            </div>
                        </div>

                        <hr />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Adresse de Livraison:</strong>
                                <p>
                                    @order.ShippingAddress<br />
                                    @order.City @order.PostalCode<br />
                                    Tél: @order.Phone
                                </p>
                            </div>
                            <div class="col-md-6">
                                <strong>Notes:</strong>
                                <p>@(string.IsNullOrEmpty(order.Notes) ? "Aucune" : order.Notes)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ARTICLES COMMANDÉS -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Articles Commandés</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Article</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-end">Prix Unitaire</th>
                                        <th class="text-end">Sous-total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitPrice.ToString("F2") DT</td>
                                            <td class="text-end fw-bold">@item.Subtotal.ToString("F2") DT</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RÉSUMÉ FINANCIER -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total:</span>
                            <span>@order.OrderItems.Sum(i => i.Subtotal).ToString("F2") DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Frais de Livraison:</span>
                            <span class="text-success">Gratuit</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <strong>Total à Payer:</strong>
                            <strong class="text-primary fs-5">@order.TotalAmount.ToString("F2") DT</strong>
                        </div>
                    </div>
                </div>

                <!-- ÉTAPES SUIVANTES -->
                <div class="alert alert-info">
                    <h6>Prochaines étapes:</h6>
                    <ol class="mb-0">
                        <li>Vous allez recevoir un email de confirmation</li>
                        <li>Préparez votre panier pour la livraison</li>
                        <li>Suivez votre commande en temps réel</li>
                        <li>Recevez votre commande à domicile</li>
                    </ol>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex gap-2 mt-4">
                    <a href="/client/orders" class="btn btn-primary flex-grow-1">
                        Voir Mes Commandes
                    </a>
                    <a href="/client/categories" class="btn btn-outline-secondary flex-grow-1">
                        Continuer vos Achats
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int OrderId { get; set; }

    private OrderDTO order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        isLoading = true;
        try
        {
            Console.WriteLine($"[OrderConfirmation] Chargement de la commande OrderId={OrderId}");
            order = await orderService.GetOrderByIdAsync(OrderId);
            
            if (order == null)
            {
                Console.Error.WriteLine($"[OrderConfirmation] La commande est null après l'appel au service");
            }
            else
            {
                Console.WriteLine($"[OrderConfirmation] Commande chargée: Status={order.Status}, Items={order.OrderItems?.Count ?? 0}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[OrderConfirmation] Exception: {ex.GetType().Name} - {ex.Message}");
            order = null;
        }
        finally
        {
            isLoading = false;
        }
    }
}
